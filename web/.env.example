# Sign-in, used by #/admin and by the nutrition review. Both screens are
# read-only without these: the rule counts and the review queue still load,
# but nothing can be proposed or approved. Project URL and anon key from the
# Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The backend. Unset takes the deployed API on Render; an empty value forces
# the bundled fixtures and runs with no backend at all.
# VITE_API_BASE_URL=http://127.0.0.1:8002

{
    "steps": [
        {
            "instruction": "Editor's Note: Named Bourbon Chicken because it was supposedly created by a Chinese cook who worked in a restaurant on Bourbon Street.",
            "step_number": 1,
            "timing_note": null,
            "duration_min": null
        },
        {
            "instruction": "Heat oil in a large skillet.",
            "step_number": 2,
            "timing_note": null,
            "duration_min": null
        },
        {
            "instruction": "Add chicken pieces and cook until lightly browned.",
            "step_number": 3,
            "timing_note": null,
            "duration_min": null
        },
        {
            "instruction": "Remove chicken.",
            "step_number": 4,
            "timing_note": null,
            "duration_min": null
        },
        {
            "instruction": "Add remaining ingredients, heating over medium Heat until well mixed and dissolved.",
            "step_number": 5,
            "timing_note": null,
            "duration_min": null
        },
        {
            "instruction": "Add chicken and bring to a hard boil.",
            "step_number": 6,
            "timing_note": null,
            "duration_min": null
        },
        {
            "instruction": "Reduce heat and simmer for 20 minutes.",
            "step_number": 7,
            "timing_note": null,
            "duration_min": null
        },
        {
            "instruction": "Serve over hot rice and ENJOY.",
            "step_number": 8,
            "timing_note": null,
            "duration_min": null
        }

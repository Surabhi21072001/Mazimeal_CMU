# Build-time configuration for the deployed front end. Vite reads this file
# automatically for `vite build`; its root is web/, which is where the Vercel
# build runs (`npm --prefix web run build`).
#
# Both values are public by design. VITE_* variables are compiled into the
# browser bundle, so nothing secret can live here: the publishable key (once
# called "anon") carries no privileges of its own and every table it can reach
# is governed by row-level security. The admin tables have RLS enabled with no
# policy at all, so this key cannot read them even in principle.
#
# Without these two, the deployed build still renders every screen, but the
# sign-in panel says it is unconfigured and no write is possible.
VITE_SUPABASE_URL=https://vvoxzwktnalrodukachl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_8nFHa1N4C9Jgu7hZaF0Dsw_jgDir6G7

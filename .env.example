# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Supabase (frontend). VITE_ variables are compiled into the browser bundle
# and are public by design; row level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shared PostgreSQL. Get these from the SharePoint credentials entry.
PGHOST=
PGPORT=5432
PGDATABASE=mazimeal
PGUSER=
PGPASSWORD=

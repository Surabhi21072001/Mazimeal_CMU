# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The Supabase connection string. Everything that talks to the live database
# reads it: the backend (as MAZI_REPO=supabase), psql, and the scripts. Get it
# from Dashboard -> Project Settings -> Database, and use the *pooler* host,
# not db.<ref>.supabase.co, which is IPv6 only. See docs/DATA.md.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
#
# The same string under the name the rules engine reads. Usually identical.
MAZIMEAL_DSN=
#
# Supabase (frontend). VITE_ variables are compiled into the browser bundle
# and are public by design; row level security is what protects the data. The
# deployed values are committed in web/.env.production on purpose.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# Tests that need Postgres run only against a LOCAL database; tests/dbguard.py
# refuses anything else, so a test run cannot truncate the shared one.
MAZIMEAL_TEST_DSN=
